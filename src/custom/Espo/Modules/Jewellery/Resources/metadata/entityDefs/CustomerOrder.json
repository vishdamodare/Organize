{
    "fields": {
        "name": {
            "type": "varchar",
            "maxLength": 150,
            "pattern": "$noBadCharacters"
        },
        "number": {
            "type": "number",
            "prefix": "ORD-",
            "nextNumber": 1,
            "padLength": 5,
            "readOnly": true
        },
        "account": {"type": "link", "required": true, "audited": true},
        "quotation": {"type": "link", "readOnly": true},
        "opportunity": {"type": "link"},
        "orderDate": {
            "type": "date",
            "required": true,
            "default": "javascript: return this.dateTime.getToday();"
        },
        "expectedDeliveryDate": {"type": "date", "audited": true},
        "status": {
            "type": "enum",
            "options": ["Draft", "Confirmed", "In Progress", "Ready for Delivery", "Delivered", "Cancelled"],
            "default": "Draft",
            "style": {"Confirmed": "primary", "In Progress": "warning", "Ready for Delivery": "warning", "Delivered": "success", "Cancelled": "info"},
            "displayAsLabel": true,
            "audited": true
        },
        "subtotal": {"type": "currency", "decimal": true, "onlyDefaultCurrency": true, "readOnly": true},
        "discountAmount": {"type": "currency", "decimal": true, "onlyDefaultCurrency": true, "readOnly": true},
        "taxAmount": {"type": "currency", "decimal": true, "onlyDefaultCurrency": true, "readOnly": true},
        "grandTotal": {"type": "currency", "decimal": true, "onlyDefaultCurrency": true, "readOnly": true, "audited": true},
        "description": {"type": "text"},
        "createdAt": {"type": "datetime", "readOnly": true},
        "modifiedAt": {"type": "datetime", "readOnly": true},
        "createdBy": {"type": "link", "readOnly": true},
        "modifiedBy": {"type": "link", "readOnly": true},
        "assignedUser": {"type": "link", "view": "views/fields/assigned-user"},
        "teams": {"type": "linkMultiple", "view": "views/fields/teams"}
    },
    "links": {
        "createdBy": {"type": "belongsTo", "entity": "User"},
        "modifiedBy": {"type": "belongsTo", "entity": "User"},
        "assignedUser": {"type": "belongsTo", "entity": "User"},
        "teams": {"type": "hasMany", "entity": "Team", "relationName": "entityTeam", "layoutRelationshipsDisabled": true},
        "account": {"type": "belongsTo", "entity": "Account", "foreign": "customerOrders"},
        "quotation": {"type": "belongsTo", "entity": "Quotation", "foreign": "orders"},
        "opportunity": {"type": "belongsTo", "entity": "Opportunity", "foreign": "customerOrders"},
        "items": {"type": "hasMany", "entity": "CustomerOrderItem", "foreign": "customerOrder"},
        "tasks": {"type": "hasChildren", "entity": "Task", "foreign": "parent"}
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc",
        "textFilterFields": ["name", "number"]
    },
    "indexes": {
        "status": {"columns": ["status", "deleted"]},
        "orderDate": {"columns": ["orderDate", "deleted"]}
    }
}
