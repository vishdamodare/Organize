{
    "fields": {
        "type": {
            "type": "enum",
            "required": true,
            "options": [
                "Retail Jewellery Shop",
                "Wholesaler",
                "Manufacturer",
                "Individual Buyer",
                "Supplier",
                "Other Business"
            ],
            "default": "Individual Buyer",
            "audited": true
        },
        "contactPerson": {
            "type": "varchar",
            "maxLength": 100,
            "pattern": "$noBadCharacters"
        },
        "customerSource": {
            "type": "enum",
            "options": [
                "",
                "Walk-in",
                "Phone",
                "WhatsApp",
                "Referral",
                "Website",
                "Exhibition",
                "Social Media",
                "Other"
            ],
            "default": ""
        },
        "tags": {
            "type": "multiEnum",
            "options": [
                "VIP",
                "Bridal",
                "Repeat Buyer",
                "Bulk Buyer",
                "Corporate Gifting"
            ],
            "allowCustomOptions": true,
            "displayAsLabel": true
        },
        "preferredContactMethod": {
            "type": "enum",
            "options": [
                "",
                "Phone",
                "WhatsApp",
                "Email",
                "In Person"
            ],
            "default": ""
        },
        "customerStatus": {
            "type": "enum",
            "options": [
                "Active",
                "Prospect",
                "Inactive"
            ],
            "default": "Active",
            "style": {
                "Active": "success",
                "Prospect": "primary",
                "Inactive": "info"
            },
            "displayAsLabel": true,
            "audited": true
        },
        "gstin": {
            "type": "varchar",
            "maxLength": 15,
            "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$",
            "tooltip": true
        },
        "lastInteractionAt": {
            "type": "datetime",
            "readOnly": true,
            "tooltip": true
        },
        "nextFollowUpAt": {
            "type": "datetime",
            "readOnly": true,
            "tooltip": true
        }
    },
    "links": {
        "enquiries": {
            "type": "hasMany",
            "entity": "Enquiry",
            "foreign": "account"
        },
        "quotations": {
            "type": "hasMany",
            "entity": "Quotation",
            "foreign": "account"
        },
        "customerOrders": {
            "type": "hasMany",
            "entity": "CustomerOrder",
            "foreign": "account"
        }
    },
    "indexes": {
        "customerStatus": {
            "columns": [
                "customerStatus",
                "deleted"
            ]
        }
    }
}
